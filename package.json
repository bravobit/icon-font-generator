{
    "name": "@bravobit/icon-font-generator",
    "version": "2.0.0",
    "description": "Generate SVG, TTF, WOFF, WOFF2 and EOT icon fonts from a folder of SVG icons.",
    "author": {
        "name": "Stan van Heumen",
        "email": "stan@bravobit.nl",
        "url": "https://bravobit.nl/"
    },
    "homepage": "https://github.com/bravobit/icon-font-generator#readme",
    "bugs": {
        "url": "https://github.com/bravobit/icon-font-generator/issues",
        "email": "stan@bravobit.nl"
    },
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "icon-font-generator": "dist/cli.js"
    },
    "files": [
        "dist",
        "src",
        "!**/*.tsbuildinfo"
    ],
    "engines": {
        "node": ">=24.14.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bravobit/icon-font-generator.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "cli",
        "icon-font-generator",
        "icon-font",
        "webfont",
        "svg",
        "ttf",
        "woff",
        "woff2",
        "eot"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
        "typecheck": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "node --run build && node --run test:only",
        "test:only": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
        "check": "node --run build && node --run lint && node --run typecheck && node --run test:only",
        "prepublishOnly": "node --run check"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "svg2ttf": "^6.1.0",
        "svgicons2svgfont": "^16.0.0",
        "svgo": "^4.1.0",
        "ttf2eot": "^3.1.0",
        "ttf2woff": "^3.0.0",
        "ttf2woff2": "^8.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "eslint": "^10.9.1",
        "tsdown": "^0.22.14",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0"
    }
}
